{
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 4 * * 1,4" }
  ],
  "rewrites": [
    { "source": "/academy", "destination": "/academy.html" },
    { "source": "/academy/apply", "destination": "/academy-apply.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

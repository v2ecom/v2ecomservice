# Copy to .env.local for local development. Never commit real values.

# Existing: Web3Forms access key for the contact + free-audit forms (public by design)
VITE_WEB3FORMS_ACCESS_KEY=

# Academy admissions (server-side only; same project/key as v2websaas. Set these in Vercel > Project > Settings > Environment Variables;
# do NOT prefix with VITE_ and never put them in frontend code)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
